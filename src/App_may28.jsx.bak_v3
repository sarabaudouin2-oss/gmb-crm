                    { label: "Posts ce mois", value: publishedPosts.filter(p2 => p2.date && p2.date.slice(0,7) === new Date().toISOString().slice(0,7)).length, col: "#6B40D8" },
                    { label: "Total publiés", value: publishedPosts.length, col: "#059669" },
