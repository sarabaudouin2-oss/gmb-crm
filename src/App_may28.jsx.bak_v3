              ? n.jsx("div", { style: { textAlign: "center", padding: "48px 0", color: "#9CA3AF", fontSize: 13 }, children: "Aucun post enregistré — ajoutez votre premier post publié." })
              : n.jsxs("div", { style: { display: "flex", flexDirection: "column", gap: 10 }, children: [
