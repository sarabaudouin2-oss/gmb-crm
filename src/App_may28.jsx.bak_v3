  ALL_CRITERIA = CATS.flatMap((e) => e.criteria),
  Ef = ALL_CRITERIA.reduce((e, t) => e + t.points, 0),
  isCriteriaApplicable = (criterion, category) => {
    if (!criterion.domainTags || criterion.domainTags.length === 0) return true;
    if (!category) return null; // unknown → show as "à vérifier"
    const cat = category.toLowerCase();
    return criterion.domainTags.some(tag => cat.includes(tag)) ? true : false;
  },
  Ri = [
    {
      min: 90,
