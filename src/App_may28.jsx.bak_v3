                n.jsx("button", { onClick: () => setShowAddPost(false), style: { background: "none", border: "1.5px solid #E5E7EB", borderRadius: 7, padding: "8px 16px", fontSize: 13, cursor: "pointer", color: "#6B7280", fontFamily: "inherit" }, children: "Annuler" }),
