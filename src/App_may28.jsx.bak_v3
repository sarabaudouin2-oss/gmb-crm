    --r-md: 12px;
    --r-lg: 16px;
    --r-xl: 24px;
  }

  *{box-sizing:border-box;margin:0;padding:0}
  html,body,#root{height:100%;overflow:hidden;font-family:'DM Sans',sans-serif;color:var(--ink);background:#F5F5F5}
  ::-webkit-scrollbar{width:4px}
  ::-webkit-scrollbar-track{background:transparent}
  ::-webkit-scrollbar-thumb{background:#c8c8e8;border-radius:4px}

  /* ── INPUTS ── */
  .inp{background:#F5F5F5;border:1.5px solid var(--border);color:var(--ink);border-radius:var(--r-sm);padding:10px 14px;font-size:13.5px;font-family:inherit;outline:none;width:100%;transition:all .2s}
  .inp:focus{border-color:var(--indigo2);background:#fff;box-shadow:0 0 0 3px rgba(37,99,235,.1)}
  .inp::placeholder{color:var(--ink4)}
  .ta{background:#F5F5F5;border:1.5px solid var(--border);color:var(--ink);border-radius:var(--r-md);padding:14px 16px;font-size:13.5px;font-family:inherit;line-height:1.8;resize:vertical;outline:none;width:100%;transition:all .2s}
  .ta:focus{border-color:var(--indigo2);background:#fff;box-shadow:0 0 0 3px rgba(37,99,235,.1)}
  .ta::placeholder{color:var(--ink4)}

  /* ── CARDS ── */
  .card{background:var(--surface);border-radius:var(--r-lg);padding:24px;box-shadow:var(--shadow-sm);border:1px solid var(--border)}
  .card-flush{background:var(--surface);border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid var(--border)}

  /* ── BUTTONS ── */
  .btn{background:var(--grad-main);color:#fff;border:none;padding:10px 22px;border-radius:var(--r-sm);font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;transition:all .18s;display:inline-flex;align-items:center;gap:7px;letter-spacing:.01em}
  .btn:hover:not(:disabled){filter:brightness(1.1);box-shadow:var(--shadow-indig);transform:translateY(-1px)}
  .btn:disabled{opacity:.4;cursor:not-allowed}
  .btn-sm{background:#fff;color:var(--indigo2);border:1.5px solid #e0e7ff;padding:6px 13px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .18s;display:inline-flex;align-items:center;gap:5px}
  .btn-sm:hover{background:#f2f0ff;border-color:var(--indigo2)}
  .btn-ghost{background:transparent;border:1.5px solid var(--border);color:var(--ink3);padding:7px 14px;border-radius:8px;font-size:12.5px;font-weight:500;cursor:pointer;font-family:inherit;transition:all .18s;display:inline-flex;align-items:center;gap:6px}
  .btn-ghost:hover{background:#F5F5F5;border-color:var(--indigo);color:var(--indigo)}
  .btn-danger{background:#fff;border:1.5px solid #fecaca;color:var(--red);padding:6px 12px;border-radius:8px;font-size:12px;cursor:pointer;font-family:inherit;font-weight:600;transition:all .18s}
  .btn-danger:hover{background:#fef2f2}

  /* ── TABS ── */
  .tab{padding:7px 16px;border-radius:8px;font-size:12.5px;font-weight:500;cursor:pointer;border:none;background:transparent;color:var(--ink4);font-family:inherit;transition:all .18s;white-space:nowrap;letter-spacing:.01em}
  .tab.on{background:#F5F5F5;color:#6B40D8;font-weight:700}
  .tab:hover:not(.on){color:#6B40D8;background:#F5F5F5}

  /* ── SIDEBAR NAV ── */
  .nav-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:9px;cursor:pointer;transition:all .18s;font-size:13px;font-weight:500;color:#475569;border:none;background:none;width:100%;font-family:inherit;text-align:left;letter-spacing:.01em}
  .nav-item:hover{background:#f2f0ff;color:#4646E5}
  .nav-item.active{background:#FDF2F8;color:#6B40D8;font-weight:700;border-radius:8px}

  /* ── CHECKLIST ── */
  .check-row{display:flex;align-items:flex-start;gap:11px;padding:10px 14px;border-radius:12px;border:1.5px solid var(--border);background:#fff;transition:all .18s;margin-bottom:6px;cursor:pointer}
  .check-row:hover{border-color:#b8b8f8;background:#fafbff}
  .check-row.done{background:#f0fdf4;border-color:#86efac;opacity:.75}
  .check-box{width:20px;height:20px;border-radius:6px;border:2px solid var(--border2);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;transition:all .18s;background:#fff}
  .check-box.done{background:#6B40D8;border-color:#6B40D8}

  /* ── TABLE ROWS ── */
  .tr{border-bottom:1px solid var(--border);transition:background .12s}
  .tr:hover{background:#F5F5F5}
  .tr:last-child{border-bottom:none}

  /* ── MISC ── */
  .chip{display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:20px;font-size:11.5px;background:#F5F5F5;border:1px solid var(--border);color:var(--ink3);font-weight:500}
  .fade{animation:fadeUp .3s ease forwards}
  @keyframes fadeUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
  .section-title{font-family:'DM Sans',sans-serif;font-size:22px;font-weight:700;color:#1E1B30;margin-bottom:4px;line-height:1.2}
  .section-sub{font-size:12.5px;color:var(--ink4);font-weight:400;margin-bottom:18px;letter-spacing:.01em}
  .kw-badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:20px;font-size:11.5px;font-weight:700}
  @keyframes spin{to{transform:rotate(360deg)}}
  @keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
  @keyframes pulse-ring{0%{transform:scale(.95);opacity:1}70%{transform:scale(1.05);opacity:.3}100%{transform:scale(.95);opacity:1}}
  .bar{height:4px;background:var(--border);border-radius:3px;overflow:hidden;width:100%}
  .bar-f{height:100%;border-radius:3px;transition:width .8s cubic-bezier(.4,0,.2,1)}
  .cal-day{min-height:80px;border:1px solid var(--border);border-radius:12px;padding:7px 8px;background:#fff;transition:all .15s;cursor:pointer}
  .cal-day:hover{border-color:rgba(37,99,235,.3);background:#fafaff}
  .cal-day.today{border-color:var(--indigo);background:#fafaff;box-shadow:0 0 0 2px rgba(37,99,235,.15)}
  .cal-day.other-month{background:#F5F5F5;opacity:.5}
  .post-chip{display:inline-flex;align-items:center;gap:4px;padding:2px 7px;border-radius:5px;font-size:10.5px;font-weight:600;margin-bottom:3px;width:100%;cursor:pointer;transition:opacity .12s}
  .post-chip.done{opacity:.4;text-decoration:line-through}
  @media print{
    .no-print{display:none!important}
    body{background:#fff!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .print-only{display:block!important}
    @page{margin:12mm 14mm;size:A4}
    aside,nav{display:none!important}
    .fade{animation:none!important}
    .card{box-shadow:none!important;border:1px solid #e2e8f0!important;break-inside:avoid}
    h1,h2,h3{break-after:avoid}
    .report-page{padding:0!important}
    .report-section{break-inside:avoid;margin-bottom:16px}
    table{break-inside:avoid}
    tr{break-inside:avoid}
  }
  .print-only{display:none}
`,
