                          n.jsx("span", { style: { background: typeColors[p2.type] || "#6B40D8", color: "white", borderRadius: 20, padding: "1px 8px", fontSize: 10, fontWeight: 700 }, children: p2.type }),
                          p2.photoCount > 0 && n.jsxs("span", { style: { fontSize: 11, color: "#0EA5E9", fontWeight: 600 }, children: ["📷 ", p2.photoCount, " photo", p2.photoCount > 1 ? "s" : ""] }),
                        ]}),
                        n.jsxs("div", { style: { fontSize: 11, color: "#9CA3AF", marginTop: 2 }, children: [
                          p2.date && new Date(p2.date).toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" }),
                          p2.note && n.jsxs("span", { children: [" · ", p2.note] }),
                        ]}),
                      ]}),
                      n.jsx("button", { onClick: () => deletePost(p2.id), style: { background: "none", border: "none", cursor: "pointer", color: "#D1D5DB", fontSize: 14, padding: 4 }, children: "✕" }),
                    ],
                  })),
                ]}),
          ]}),
        ]
      }),
    ]
  });
}
function MonthlyTab({ client: e, clients: t, upd: i, calcScore: r }) {
  const CM = new Date().toISOString().slice(0, 7); // current month YYYY-MM
  const snapshots = e.monthlySnapshots || [];
  const publishedPosts = e.publishedPosts || [];
  const profileUpdates = e.profileUpdates || [];
  const [subTab, setSubTab] = D.useState("activite");
  const [showReport, setShowReport] = D.useState(false);

  // Snapshot form
  const [snapNote, setSnapNote] = D.useState("");
  const [snapPosts, setSnapPosts] = D.useState("");

  // Add post form
  const postTypes = ["Realisation","Conseil","Offre","Temoignage","Actualite","Coulisses","Question"];
  const typeIcons = { Realisation:"🏆",Conseil:"💡",Offre:"🎁",Temoignage:"⭐",Actualite:"📢",Coulisses:"🎬",Question:"❓" };
  const typeColors = { Realisation:"#6B40D8",Conseil:"#0891b2",Offre:"#059669",Temoignage:"#d97706",Actualite:"#C03080",Coulisses:"#7c3aed",Question:"#dc2626" };
  const updateFields = ["Catégorie principale","Catégories secondaires","Description","Horaires","Téléphone","Site web","Adresse","Photos","Services","Produits","Attributs","Questions/Réponses","Autre"];

  const [showAddPost, setShowAddPost] = D.useState(false);
  const [newPost, setNewPost] = D.useState({ title:"", type:"Realisation", date:new Date().toISOString().slice(0,10), photoCount:0, note:"" });
  const [showAddUpdate, setShowAddUpdate] = D.useState(false);
  const [newUpdate, setNewUpdate] = D.useState({ date:new Date().toISOString().slice(0,10), field:"", change:"", note:"" });

  // Current data
  const extracted = (e.data || {}).extracted || {};
  const currentScore = r({ ...(e.scores||{}), ...(e.manualOverrides||{}) });
  const geoGrid = e.geoGrid || {};
  const perf = e.perf || {};
  const lastSnap = snapshots.length > 0 ? snapshots[snapshots.length-1] : null;
  const prevSnap = snapshots.length > 1 ? snapshots[snapshots.length-2] : null;

  // Current month filters
  const monthPosts = publishedPosts.filter(p2 => p2.date && p2.date.slice(0,7) === CM);
  const monthUpdates = profileUpdates.filter(u2 => u2.date && u2.date.slice(0,7) === CM);

  // Map positions from geoGrid
  const mapPositions = Object.entries(geoGrid).filter(([k]) => k !== "center").map(([kw, kwData]) => {
    if (!kwData || !kwData.scans || kwData.scans.length === 0) return null;
    const lastScan = kwData.scans[kwData.scans.length-1];
    const cells = lastScan.cells || [];
    const ranks = cells.map(c => c.rank).filter(r2 => r2 && r2 < 21);
    if (ranks.length === 0) return null;
    const avg = Math.round(ranks.reduce((a,b) => a+b,0)/ranks.length*10)/10;
    const top3 = ranks.filter(r2 => r2 <= 3).length;
    const top10 = ranks.filter(r2 => r2 <= 10).length;
    const total = cells.length;
    const scanDate = lastScan.date ? new Date(lastScan.date).toLocaleDateString("fr-FR",{day:"numeric",month:"short"}) : "?";
    // compare with last snapshot positions
    const prevPos = lastSnap ? (lastSnap.positions||{})[kw] : null;
    return { kw, avg, top3, top10, total, scanDate, prevPos };
  }).filter(Boolean);

  const savePost = () => {
    if (!newPost.title.trim()) return;
    const updated = t.map(cl => cl.id === e.id ? { ...cl, publishedPosts: [...publishedPosts, { ...newPost, id: Date.now() }] } : cl);
    i(updated);
    setNewPost({ title:"", type:"Realisation", date:new Date().toISOString().slice(0,10), photoCount:0, note:"" });
    setShowAddPost(false);
  };
  const deletePost = (id) => i(t.map(cl => cl.id === e.id ? { ...cl, publishedPosts: publishedPosts.filter(p2 => p2.id !== id) } : cl));

  const saveUpdate = () => {
    if (!newUpdate.field || !newUpdate.change.trim()) return;
    const updated = t.map(cl => cl.id === e.id ? { ...cl, profileUpdates: [...profileUpdates, { ...newUpdate, id: Date.now() }] } : cl);
    i(updated);
    setNewUpdate({ date:new Date().toISOString().slice(0,10), field:"", change:"", note:"" });
    setShowAddUpdate(false);
  };
  const deleteUpdate = (id) => i(t.map(cl => cl.id === e.id ? { ...cl, profileUpdates: profileUpdates.filter(u2 => u2.id !== id) } : cl));

  const takeSnapshot = () => {
    const scores = { ...(e.scores||{}), ...(e.manualOverrides||{}) };
    const score = r(scores);
    const reviewCount = parseInt(extracted.reviewCount) || null;
    const photoCount = parseInt(extracted.photoCount) || null;
    const positions = {};
    Object.entries(geoGrid).forEach(([kw, kwData]) => {
      if (kw === "center" || !kwData?.scans?.length) return;
      const lastScan = kwData.scans[kwData.scans.length-1];
      const cells = lastScan.cells || [];
      const ranks = cells.map(c => c.rank).filter(r2 => r2 && r2 < 21);
      if (ranks.length > 0) positions[kw] = Math.round(ranks.reduce((a,b)=>a+b,0)/ranks.length*10)/10;
    });
    const now = new Date();
    const snap = {
      id: Date.now(),
      date: now.toISOString().slice(0,10),
      label: now.toLocaleDateString("fr-FR", { month:"long", year:"numeric" }),
      score, reviewCount, photoCount,
      postsCount: parseInt(snapPosts) || monthPosts.length,
      postsThisMonth: monthPosts.length,
      updatesThisMonth: monthUpdates.length,
      note: snapNote.trim(),
      positions,
    };
    const updated = t.map(cl => cl.id === e.id ? { ...cl, monthlySnapshots: [...snapshots, snap] } : cl);
    i(updated);
    setSnapNote(""); setSnapPosts("");
  };
  const deleteSnapshot = (id) => i(t.map(cl => cl.id === e.id ? { ...cl, monthlySnapshots: snapshots.filter(s => s.id !== id) } : cl));

  const diff = (a, b) => {
    if (a == null || b == null) return null;
    return a - b;
  };
  const diffEl = (a, b, invert=false) => {
    const d = diff(a, b);
    if (d == null) return n.jsx("span", { style:{color:"#9CA3AF"}, children:"—" });
    if (d === 0) return n.jsx("span", { style:{color:"#6B7280",fontWeight:600}, children:"→" });
    const good = invert ? d < 0 : d > 0;
    return n.jsx("span", { style:{color:good?"#059669":"#DC2626",fontWeight:700}, children: `${d>0?"↑ +":"↓ "}${Math.abs(d)}` });
  };

  const scCol = (s) => s >= 70 ? "#059669" : s >= 50 ? "#d97706" : "#E85A30";

  const buildReportHtml = () => {
    if (snapshots.length < 1) return "";
    const curr = snapshots[snapshots.length-1];
    const prev = snapshots.length >= 2 ? snapshots[snapshots.length-2] : null;
    const agencyName = localStorage.getItem("agencyName") || "BeTheOne";
    const agencyEmail = localStorage.getItem("agencyEmail") || "";
    const agencyPhone = localStorage.getItem("agencyPhone") || "";
    const clientName = extracted.name || e.name || "Client";
    const evo = (c2, p2, inv=false) => {
      if (c2==null||p2==null) return '<span style="color:#9CA3AF">—</span>';
      const d = c2-p2;
      if (d===0) return '<span style="color:#6B7280">→</span>';
      const good = inv ? d<0 : d>0;
      return `<span style="color:${good?"#059669":"#DC2626"};font-weight:700">${d>0?"↑ +":"↓ "}${Math.abs(d)}</span>`;
    };
    const allKwKeys = [...new Set([...Object.keys(curr.positions||{}), ...(prev?Object.keys(prev.positions||{}):[]) ])];
    const kwRows = allKwKeys.slice(0,8).map(kw => {
      const cp=curr.positions[kw]; const pp=prev?(prev.positions||{})[kw]:null;
      const d=cp!=null&&pp!=null?cp-pp:null;
      const good=d!=null&&d<0; const bad=d!=null&&d>0;
      return `<tr>
        <td style="padding:8px 14px;border-bottom:1px solid #F3F4F6;font-size:13px;color:#374151">${kw}</td>
        <td style="padding:8px 14px;border-bottom:1px solid #F3F4F6;text-align:center;font-size:13px;color:#9CA3AF">${pp!=null?`#${pp}`:"—"}</td>
        <td style="padding:8px 14px;border-bottom:1px solid #F3F4F6;text-align:center;font-size:14px;font-weight:800;color:#374151">${cp!=null?`#${cp}`:"—"}</td>
        <td style="padding:8px 14px;border-bottom:1px solid #F3F4F6;text-align:center;font-size:13px">${d==null?'<span style="color:#9CA3AF">—</span>':`<span style="color:${good?"#059669":bad?"#DC2626":"#6B7280"};font-weight:700">${good?"↑ ":"↓ "}${d>0?"+":""}${Math.abs(d)}</span>`}</td>
      </tr>`;
    }).join("");
    const sc = curr.score >= 70 ? "#059669" : curr.score >= 50 ? "#d97706" : "#E85A30";
    // posts this month
    const monthPostsForReport = publishedPosts.filter(p2 => p2.date && p2.date.slice(0,7) === curr.date.slice(0,7));
    const monthUpdatesForReport = profileUpdates.filter(u2 => u2.date && u2.date.slice(0,7) === curr.date.slice(0,7));
    const postsRows = monthPostsForReport.map(p2 => `<tr>
      <td style="padding:7px 14px;border-bottom:1px solid #F3F4F6;font-size:13px;color:#374151">${p2.title}</td>
      <td style="padding:7px 14px;border-bottom:1px solid #F3F4F6;font-size:11px;color:#9CA3AF;text-align:center">${p2.type||""}</td>
      <td style="padding:7px 14px;border-bottom:1px solid #F3F4F6;font-size:11px;color:#9CA3AF;text-align:center">${p2.date?new Date(p2.date).toLocaleDateString("fr-FR",{day:"numeric",month:"short"}):""}</td>
      <td style="padding:7px 14px;border-bottom:1px solid #F3F4F6;font-size:12px;text-align:center;color:#0EA5E9">${p2.photoCount>0?`📷 ${p2.photoCount}`:""}</td>
    </tr>`).join("");
    const updatesRows = monthUpdatesForReport.map(u2 => `<tr>
      <td style="padding:7px 14px;border-bottom:1px solid #F3F4F6;font-size:11px;font-weight:700;color:#059669">${u2.field}</td>
      <td style="padding:7px 14px;border-bottom:1px solid #F3F4F6;font-size:13px;color:#374151">${u2.change}</td>
      <td style="padding:7px 14px;border-bottom:1px solid #F3F4F6;font-size:11px;color:#9CA3AF">${u2.date?new Date(u2.date).toLocaleDateString("fr-FR",{day:"numeric",month:"short"}):""}</td>
    </tr>`).join("");

    return `<style>
      .rm-page{background:white;width:100%;position:relative;overflow:hidden;font-family:'Helvetica Neue',Arial,sans-serif}
      .rm-bar{height:5px;background:linear-gradient(90deg,#6B40D8,#C03080,#E85A30);width:100%}
      .rm-body{padding:36px 44px}
      .rm-section{font-size:14px;font-weight:800;color:#1F2937;margin:24px 0 10px;padding-bottom:6px;border-bottom:2px solid #F3F4F6;display:flex;align-items:center;gap:8px}
      .rm-metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0}
      .rm-metric{background:#F9FAFB;border:1.5px solid #E5E7EB;border-radius:12px;padding:14px 10px;text-align:center}
      .rm-metric-val{font-size:28px;font-weight:900;line-height:1;margin-bottom:3px}
      .rm-metric-lbl{font-size:10px;color:#9CA3AF;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px}
      .rm-metric-evo{font-size:12px}
      table{width:100%;border-collapse:collapse}
      th{background:#F9FAFB;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:#9CA3AF;padding:7px 14px;text-align:left}
      .rm-note{background:#F0FDF4;border:1.5px solid #BBF7D0;border-radius:10px;padding:12px 16px;font-size:13px;color:#166534;margin-top:16px}
      .rm-footer{font-size:11px;color:#D1D5DB;text-align:center;margin-top:28px;border-top:1px solid #F3F4F6;padding-top:14px}
      .tag{display:inline-block;background:#6B40D8;color:white;border-radius:20px;padding:1px 8px;font-size:10px;font-weight:700}
      @media print{body{background:white}.rm-page{margin:0}}
    </style>
    <div class="rm-page">
      <div class="rm-bar"></div>
      <div class="rm-body">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">
          <div>
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:#9CA3AF;margin-bottom:5px">Rapport mensuel · ${curr.label}</div>
            <div style="font-size:24px;font-weight:900;color:#1F2937;line-height:1.1">${clientName}</div>
            <div style="font-size:12px;color:#6B7280;margin-top:3px">Suivi de visibilité Google My Business</div>
          </div>
          <div style="text-align:right">
            <div style="font-size:13px;font-weight:800;color:#6B40D8">${agencyName}</div>
            ${agencyEmail?`<div style="font-size:11px;color:#9CA3AF;margin-top:2px">${agencyEmail}</div>`:""}
            ${agencyPhone?`<div style="font-size:11px;color:#9CA3AF">${agencyPhone}</div>`:""}
          </div>
        </div>

        ${prev?`<div style="background:#F0FDF4;border:1.5px solid #BBF7D0;border-radius:10px;padding:10px 16px;font-size:12px;color:#166534;margin-bottom:4px">📊 Comparaison avec <strong>${prev.label}</strong></div>`
        :`<div style="background:#FEF3C7;border:1.5px solid #FDE68A;border-radius:10px;padding:10px 16px;font-size:12px;color:#92400E;margin-bottom:4px">📸 Premier snapshot — l'évolution sera visible dès le mois prochain</div>`}

        <div class="rm-section">📊 Résultats du mois</div>
        <div class="rm-metric-grid">
          <div class="rm-metric" style="border-top:3px solid ${sc}">
            <div class="rm-metric-lbl">Score GMB</div>
            <div class="rm-metric-val" style="color:${sc}">${curr.score}</div>
            <div class="rm-metric-evo">${prev?evo(curr.score,prev.score):'<span style="color:#9CA3AF">—</span>'}</div>
          </div>
          <div class="rm-metric" style="border-top:3px solid #6B40D8">
            <div class="rm-metric-lbl">Avis Google</div>
            <div class="rm-metric-val" style="color:#6B40D8">${curr.reviewCount??"—"}</div>
            <div class="rm-metric-evo">${prev?evo(curr.reviewCount,prev.reviewCount):'<span style="color:#9CA3AF">—</span>'}</div>
          </div>
          <div class="rm-metric" style="border-top:3px solid #0EA5E9">
            <div class="rm-metric-lbl">Photos</div>
            <div class="rm-metric-val" style="color:#0EA5E9">${curr.photoCount??"—"}</div>
            <div class="rm-metric-evo">${prev?evo(curr.photoCount,prev.photoCount):'<span style="color:#9CA3AF">—</span>'}</div>
          </div>
          <div class="rm-metric" style="border-top:3px solid #F59E0B">
            <div class="rm-metric-lbl">Posts publiés</div>
            <div class="rm-metric-val" style="color:#F59E0B">${curr.postsCount??"—"}</div>
            <div class="rm-metric-evo">${prev?evo(curr.postsCount,prev.postsCount):'<span style="color:#9CA3AF">—</span>'}</div>
          </div>
        </div>

        ${allKwKeys.length>0?`
        <div class="rm-section">🗺️ Positions carte Google</div>
        <table>
          <thead><tr><th>Mot-clé</th><th style="text-align:center">Mois préc.</th><th style="text-align:center">Ce mois</th><th style="text-align:center">Évolution</th></tr></thead>
          <tbody>${kwRows}</tbody>
        </table>`:""}

        ${monthPostsForReport.length>0?`
        <div class="rm-section">✍️ Publications du mois (${monthPostsForReport.length})</div>
        <table>
          <thead><tr><th>Titre</th><th style="text-align:center">Type</th><th style="text-align:center">Date</th><th style="text-align:center">Photos</th></tr></thead>
          <tbody>${postsRows}</tbody>
        </table>`:""}

        ${monthUpdatesForReport.length>0?`
        <div class="rm-section">🔧 Optimisations fiche (${monthUpdatesForReport.length})</div>
        <table>
          <thead><tr><th>Élément</th><th>Modification</th><th style="text-align:center">Date</th></tr></thead>
          <tbody>${updatesRows}</tbody>
        </table>`:""}

        ${curr.note?`<div class="rm-note">💬 ${curr.note}</div>`:""}
        <div class="rm-footer">${agencyName} · Rapport confidentiel · ${new Date().toLocaleDateString("fr-FR")}</div>
      </div>
    </div>`;
  };

  const exportPdf = async () => {
    window.html2pdf || await new Promise((res,rej) => {
      const s = document.createElement("script");
      s.src = "https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js";
      s.onload=res; s.onerror=rej; document.head.appendChild(s);
    });
    const el = document.getElementById("rapport-mensuel-content");
    if (!el) return;
    window.html2pdf().set({
      margin:10,
      filename:`rapport_mensuel_${e.name.replace(/\s+/g,"_")}_${new Date().toISOString().slice(0,7)}.pdf`,
      image:{type:"jpeg",quality:0.95},
      html2canvas:{scale:2,useCORS:true},
      jsPDF:{unit:"mm",format:"a4",orientation:"portrait"},
    }).from(el).save();
  };

  const tabs2 = [
    { id:"activite", label:"✍️ Activité du mois" },
    { id:"evolution", label:"📊 Évolution" },
    { id:"snapshot", label:`📸 Snapshots (${snapshots.length})` },
    { id:"rapport", label:"📄 Rapport client" },
  ];

  const monthLabel = new Date().toLocaleDateString("fr-FR",{month:"long",year:"numeric"});

  return n.jsxs("div", {
    style:{display:"flex",flexDirection:"column",height:"100%"},
    children:[
      // Header
      n.jsxs("div", {
        style:{padding:"14px 24px 0",borderBottom:"1px solid #F3F4F6"},
        children:[
          n.jsxs("div", {
            style:{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:12},
            children:[
              n.jsxs("div", {children:[
                n.jsx("div", {style:{fontSize:17,fontWeight:800,color:"#1E1B30"},children:"📅 Suivi mensuel"}),
                n.jsx("div", {style:{fontSize:12,color:"#9CA3AF",marginTop:2},children:`Mois en cours : ${monthLabel}`}),
              ]}),
              n.jsxs("div", {style:{display:"flex",gap:8},children:[
                n.jsx("button", {
                  onClick:()=>setShowReport(v=>!v),
                  disabled:snapshots.length===0,
                  style:{background:showReport?"#F3F4F6":"white",border:"1.5px solid #E5E7EB",borderRadius:8,padding:"7px 14px",fontSize:12,fontWeight:600,cursor:snapshots.length===0?"not-allowed":"pointer",color:snapshots.length===0?"#D1D5DB":"#374151",fontFamily:"inherit"},
                  children:showReport?"← Masquer":"👁 Aperçu rapport",
                }),
                n.jsx("button", {
                  onClick:exportPdf,
                  disabled:snapshots.length===0,
                  style:{background:snapshots.length===0?"#F3F4F6":"linear-gradient(135deg,#6B40D8,#C03080)",border:"none",borderRadius:8,padding:"7px 14px",fontSize:12,fontWeight:700,cursor:snapshots.length===0?"not-allowed":"pointer",color:snapshots.length===0?"#D1D5DB":"white",fontFamily:"inherit"},
                  children:"⬇️ Exporter PDF",
                }),
              ]}),
            ]
          }),
          // Sub-tabs
          n.jsx("div", {
            style:{display:"flex",gap:4,overflowX:"auto"},
            children:tabs2.map(tb=>n.jsx("button",{
              key:tb.id,
              onClick:()=>setSubTab(tb.id),
              style:{background:"none",border:"none",borderBottom:subTab===tb.id?"2px solid #6B40D8":"2px solid transparent",color:subTab===tb.id?"#6B40D8":"#6B7280",fontWeight:subTab===tb.id?700:500,fontSize:13,padding:"7px 12px 9px",cursor:"pointer",whiteSpace:"nowrap",fontFamily:"inherit"},
              children:tb.label,
            })),
          }),
        ]
      }),

      // Main content (split when report preview open)
      n.jsxs("div", {
        style:{flex:1,display:"flex",overflowY:"hidden"},
        children:[
          // Left panel
          n.jsxs("div", {
            style:{flex:1,overflowY:"auto",padding:"22px 26px",borderRight:showReport?"1px solid #F3F4F6":"none"},
            children:[

              // ── ACTIVITÉ DU MOIS ──
              subTab==="activite" && n.jsxs("div", {className:"fade",children:[

                // Stats rapides du mois
                n.jsxs("div", {style:{display:"flex",gap:10,marginBottom:22,flexWrap:"wrap"},children:[
                  {label:"Posts ce mois",val:monthPosts.length,col:"#6B40D8",icon:"✍️"},
                  {label:"Photos publiées",val:monthPosts.reduce((acc,p2)=>acc+(p2.photoCount||0),0),col:"#0EA5E9",icon:"📷"},
                  {label:"Optimisations fiche",val:monthUpdates.length,col:"#059669",icon:"🔧"},
                ].map(s=>n.jsxs("div",{
                  key:s.label,
                  style:{background:"white",border:"1.5px solid #E5E7EB",borderRadius:12,padding:"12px 18px",display:"flex",alignItems:"center",gap:12,flex:"1 1 140px"},
                  children:[
                    n.jsx("div",{style:{fontSize:26,fontWeight:900,color:s.col},children:s.val}),
                    n.jsxs("div",{style:{fontSize:12,color:"#6B7280",lineHeight:1.4},children:[n.jsx("div",{style:{fontWeight:700},children:s.icon+" "+s.label})]}),
                  ]
                }))
                }),

                // Posts publiés ce mois
                n.jsxs("div", {style:{marginBottom:24},children:[
                  n.jsxs("div", {style:{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:10},children:[
                    n.jsx("div",{style:{fontSize:14,fontWeight:800,color:"#1E1B30"},children:"✍️ Publications du mois"}),
                    n.jsx("button",{onClick:()=>setShowAddPost(true),style:{background:"#6B40D8",color:"white",border:"none",borderRadius:7,padding:"6px 14px",fontSize:12,fontWeight:700,cursor:"pointer",fontFamily:"inherit"},children:"+ Ajouter"}),
                  ]}),
                  showAddPost && n.jsxs("div",{style:{background:"#F9FAFB",border:"1.5px solid #E5E7EB",borderRadius:12,padding:"14px 18px",marginBottom:12},children:[
                    n.jsxs("div",{style:{display:"flex",gap:8,flexWrap:"wrap",marginBottom:8},children:[
                      n.jsxs("div",{style:{flex:2,minWidth:160},children:[
                        n.jsx("label",{style:{fontSize:11,color:"#6B7280",display:"block",marginBottom:3,fontWeight:600},children:"Titre *"}),
                        n.jsx("input",{type:"text",value:newPost.title,onChange:ev=>setNewPost(p2=>({...p2,title:ev.target.value})),placeholder:"Ex : Rénovation salle de bain...",style:{width:"100%",padding:"7px 10px",border:"1.5px solid #D1D5DB",borderRadius:7,fontSize:13,boxSizing:"border-box"}}),
                      ]}),
                      n.jsxs("div",{children:[
                        n.jsx("label",{style:{fontSize:11,color:"#6B7280",display:"block",marginBottom:3,fontWeight:600},children:"Type"}),
                        n.jsx("select",{value:newPost.type,onChange:ev=>setNewPost(p2=>({...p2,type:ev.target.value})),style:{padding:"7px 9px",border:"1.5px solid #D1D5DB",borderRadius:7,fontSize:13,fontFamily:"inherit"},children:postTypes.map(pt=>n.jsx("option",{value:pt,children:`${typeIcons[pt]} ${pt}`},pt))}),
                      ]}),
                      n.jsxs("div",{children:[
                        n.jsx("label",{style:{fontSize:11,color:"#6B7280",display:"block",marginBottom:3,fontWeight:600},children:"Date"}),
                        n.jsx("input",{type:"date",value:newPost.date,onChange:ev=>setNewPost(p2=>({...p2,date:ev.target.value})),style:{padding:"7px 9px",border:"1.5px solid #D1D5DB",borderRadius:7,fontSize:13,fontFamily:"inherit"}}),
                      ]}),
                      n.jsxs("div",{children:[
                        n.jsx("label",{style:{fontSize:11,color:"#6B7280",display:"block",marginBottom:3,fontWeight:600},children:"Nb photos"}),
                        n.jsx("input",{type:"number",min:0,value:newPost.photoCount,onChange:ev=>setNewPost(p2=>({...p2,photoCount:parseInt(ev.target.value)||0})),style:{width:75,padding:"7px 9px",border:"1.5px solid #D1D5DB",borderRadius:7,fontSize:13}}),
                      ]}),
                    ]}),
                    n.jsxs("div",{style:{display:"flex",gap:7},children:[
                      n.jsx("button",{onClick:savePost,style:{background:"#6B40D8",color:"white",border:"none",borderRadius:7,padding:"7px 18px",fontSize:12,fontWeight:700,cursor:"pointer",fontFamily:"inherit"},children:"✅ Enregistrer"}),
                      n.jsx("button",{onClick:()=>setShowAddPost(false),style:{background:"none",border:"1.5px solid #E5E7EB",borderRadius:7,padding:"7px 14px",fontSize:12,cursor:"pointer",color:"#6B7280",fontFamily:"inherit"},children:"Annuler"}),
                    ]}),
                  ]}),
                  monthPosts.length===0&&!showAddPost
                    ? n.jsx("div",{style:{background:"#F9FAFB",borderRadius:10,padding:"16px",textAlign:"center",fontSize:12,color:"#9CA3AF"},children:"Aucun post ce mois — ajoutez les publications réalisées."})
                    : n.jsx("div",{style:{display:"flex",flexDirection:"column",gap:8},children:
                        [...publishedPosts].filter(p2=>p2.date&&p2.date.slice(0,7)===CM).reverse().map(p2=>n.jsxs("div",{
                          key:p2.id,
                          style:{background:"white",border:"1px solid #E5E7EB",borderRadius:10,padding:"10px 14px",display:"flex",alignItems:"center",gap:12},
                          children:[
                            n.jsx("div",{style:{width:32,height:32,background:`${typeColors[p2.type]||"#6B40D8"}18`,borderRadius:8,display:"flex",alignItems:"center",justifyContent:"center",fontSize:16,flexShrink:0},children:typeIcons[p2.type]||"📝"}),
                            n.jsxs("div",{style:{flex:1,minWidth:0},children:[
                              n.jsxs("div",{style:{display:"flex",alignItems:"center",gap:7,flexWrap:"wrap"},children:[
                                n.jsx("span",{style:{fontSize:13,fontWeight:700,color:"#1E1B30"},children:p2.title}),
                                n.jsx("span",{style:{background:typeColors[p2.type]||"#6B40D8",color:"white",borderRadius:20,padding:"1px 7px",fontSize:9,fontWeight:700},children:p2.type}),
                                p2.photoCount>0&&n.jsxs("span",{style:{fontSize:11,color:"#0EA5E9",fontWeight:600},children:["📷 ",p2.photoCount]}),
                              ]}),
                              n.jsx("div",{style:{fontSize:11,color:"#9CA3AF",marginTop:2},children:p2.date&&new Date(p2.date).toLocaleDateString("fr-FR",{day:"numeric",month:"short"})}),
                            ]}),
                            n.jsx("button",{onClick:()=>deletePost(p2.id),style:{background:"none",border:"none",cursor:"pointer",color:"#D1D5DB",fontSize:13,padding:2},children:"✕"}),
                          ]
                        }))
                      }),
                ]}),

                // Mises à jour fiche ce mois
                n.jsxs("div",{children:[
                  n.jsxs("div",{style:{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:10},children:[
                    n.jsx("div",{style:{fontSize:14,fontWeight:800,color:"#1E1B30"},children:"🔧 Optimisations fiche du mois"}),
                    n.jsx("button",{onClick:()=>setShowAddUpdate(true),style:{background:"#059669",color:"white",border:"none",borderRadius:7,padding:"6px 14px",fontSize:12,fontWeight:700,cursor:"pointer",fontFamily:"inherit"},children:"+ Ajouter"}),
                  ]}),
                  showAddUpdate && n.jsxs("div",{style:{background:"#F9FAFB",border:"1.5px solid #E5E7EB",borderRadius:12,padding:"14px 18px",marginBottom:12},children:[
                    n.jsxs("div",{style:{display:"flex",gap:8,flexWrap:"wrap",marginBottom:8},children:[
                      n.jsxs("div",{children:[
                        n.jsx("label",{style:{fontSize:11,color:"#6B7280",display:"block",marginBottom:3,fontWeight:600},children:"Date"}),
                        n.jsx("input",{type:"date",value:newUpdate.date,onChange:ev=>setNewUpdate(u2=>({...u2,date:ev.target.value})),style:{padding:"7px 9px",border:"1.5px solid #D1D5DB",borderRadius:7,fontSize:13,fontFamily:"inherit"}}),
                      ]}),
                      n.jsxs("div",{children:[
                        n.jsx("label",{style:{fontSize:11,color:"#6B7280",display:"block",marginBottom:3,fontWeight:600},children:"Élément modifié *"}),
                        n.jsx("select",{value:newUpdate.field,onChange:ev=>setNewUpdate(u2=>({...u2,field:ev.target.value})),style:{padding:"7px 9px",border:"1.5px solid #D1D5DB",borderRadius:7,fontSize:13,fontFamily:"inherit"},children:[
                          n.jsx("option",{value:"",children:"— Choisir —"}),
                          ...updateFields.map(f2=>n.jsx("option",{value:f2,children:f2},f2)),
                        ]}),
                      ]}),
                      n.jsxs("div",{style:{flex:1,minWidth:180},children:[
                        n.jsx("label",{style:{fontSize:11,color:"#6B7280",display:"block",marginBottom:3,fontWeight:600},children:"Ce qui a été changé *"}),
                        n.jsx("input",{type:"text",value:newUpdate.change,onChange:ev=>setNewUpdate(u2=>({...u2,change:ev.target.value})),placeholder:"Ex : Ajout 5 photos intérieur...",style:{width:"100%",padding:"7px 9px",border:"1.5px solid #D1D5DB",borderRadius:7,fontSize:13,boxSizing:"border-box"}}),
                      ]}),
                    ]}),
                    n.jsxs("div",{style:{display:"flex",gap:7},children:[
                      n.jsx("button",{onClick:saveUpdate,style:{background:"#059669",color:"white",border:"none",borderRadius:7,padding:"7px 18px",fontSize:12,fontWeight:700,cursor:"pointer",fontFamily:"inherit"},children:"✅ Enregistrer"}),
                      n.jsx("button",{onClick:()=>setShowAddUpdate(false),style:{background:"none",border:"1.5px solid #E5E7EB",borderRadius:7,padding:"7px 14px",fontSize:12,cursor:"pointer",color:"#6B7280",fontFamily:"inherit"},children:"Annuler"}),
                    ]}),
                  ]}),
                  monthUpdates.length===0&&!showAddUpdate
                    ? n.jsx("div",{style:{background:"#F9FAFB",borderRadius:10,padding:"16px",textAlign:"center",fontSize:12,color:"#9CA3AF"},children:"Aucune mise à jour ce mois — enregistrez les optimisations réalisées."})
                    : n.jsx("div",{style:{display:"flex",flexDirection:"column",gap:8},children:
                        [...profileUpdates].filter(u2=>u2.date&&u2.date.slice(0,7)===CM).reverse().map(u2=>n.jsxs("div",{
                          key:u2.id,
                          style:{background:"white",border:"1px solid #E5E7EB",borderRadius:10,padding:"10px 14px",display:"flex",alignItems:"center",gap:12},
                          children:[
                            n.jsx("div",{style:{width:32,height:32,background:"#F0FDF4",borderRadius:8,display:"flex",alignItems:"center",justifyContent:"center",fontSize:16,flexShrink:0},children:"🔧"}),
                            n.jsxs("div",{style:{flex:1,minWidth:0},children:[
                              n.jsxs("div",{style:{display:"flex",alignItems:"center",gap:7,flexWrap:"wrap"},children:[
                                n.jsx("span",{style:{background:"#059669",color:"white",borderRadius:20,padding:"1px 8px",fontSize:9,fontWeight:700},children:u2.field}),
                                n.jsx("span",{style:{fontSize:13,fontWeight:600,color:"#1E1B30"},children:u2.change}),
                              ]}),
                              n.jsx("div",{style:{fontSize:11,color:"#9CA3AF",marginTop:2},children:u2.date&&new Date(u2.date).toLocaleDateString("fr-FR",{day:"numeric",month:"short"})}),
                            ]}),
                            n.jsx("button",{onClick:()=>deleteUpdate(u2.id),style:{background:"none",border:"none",cursor:"pointer",color:"#D1D5DB",fontSize:13,padding:2},children:"✕"}),
                          ]
                        }))
                      }),
                ]}),
              ]}),

              // ── ÉVOLUTION ──
              subTab==="evolution" && n.jsxs("div", {className:"fade",children:[
                // Score + avis
                n.jsx("div",{style:{fontSize:14,fontWeight:800,color:"#1E1B30",marginBottom:12},children:"📊 Score & Avis"}),
                n.jsxs("div",{style:{display:"flex",gap:12,marginBottom:24,flexWrap:"wrap"},children:[
                  {label:"Score GMB",val:currentScore,col:scCol(currentScore),prevVal:lastSnap?.score,icon:"🏆"},
                  {label:"Avis Google",val:parseInt(extracted.reviewCount)||null,col:"#6B40D8",prevVal:lastSnap?.reviewCount,icon:"⭐"},
                  {label:"Note moyenne",val:parseFloat(extracted.rating)||null,col:"#F59E0B",prevVal:null,icon:"⭐",dec:1},
