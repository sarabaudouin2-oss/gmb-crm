function formatDate(e, t) {
  const i = {},
    r = {
      Lundi: 1,
      Mardi: 2,
      Mercredi: 3,
      Jeudi: 4,
      Vendredi: 5,
      Samedi: 6,
      Dimanche: 0,
    },
    o = new Date(t),
    s = o.getDay(),
    l = s === 1 ? 0 : s === 0 ? 1 : 8 - s;
  return (
    o.setDate(o.getDate() + l),
    (e || []).slice(0, 12).forEach((a, d) => {
      const p = new Date(o);
      p.setDate(o.getDate() + d * 7);
      const b = r[a.bestDay] ?? 1,
        x = p.getDay() === 0 ? 7 : p.getDay(),
        j = b - x,
        I = new Date(p);
      I.setDate(p.getDate() + (j >= 0 ? j : j + 7));
      const z = `${I.getFullYear()}-${String(I.getMonth() + 1).padStart(2, "0")}-${String(I.getDate()).padStart(2, "0")}`;
      (i[z] || (i[z] = []),
        i[z].push({
          id: Date.now() + d,
          type: a.type,
          title: a.title,
          content: a.content || "",
          keywords: a.keywords || [],
          cta: a.cta || "",
          week: a.week || d + 1,
          done: !1,
          fromAudit: !0,
        }));
    }),
    i
  );
}
